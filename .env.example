APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Apex domain for the dashboard.* / admin.* subdomain route groups
# (routes/domains.php, MIGRATION_PLAN.md ADR-21). "localhost" resolves
# dashboard.localhost / admin.localhost automatically in modern browsers.
# Set to the real apex ("hetkin.app") in production.
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to ".hetkin.app" (leading dot) in production to share the session
# cookie across the apex domain and the dashboard./admin. subdomains — see
# MIGRATION_PLAN.md ADR-21. Left unset in local dev; see APP_DOMAIN above.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log (this default) reproduces v2's own "log the email
# instead of sending" fallback when RESEND_API_KEY is unset — Laravel picks
# the mailer at deploy time via this var rather than v2's own runtime
# process.env.RESEND_API_KEY check, but the observable result is the same:
# nothing sends until Resend is actually configured. Set MAIL_MAILER=resend
# and RESEND_API_KEY (below) together in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Leave as the default below until the hetkin.app domain is added and
# verified as a sending domain in Resend — matching v2's own
# RESEND_FROM_ADDRESS comment exactly: with an unverified domain, Resend
# silently rejects any send to a recipient other than your own account's
# verified address, which is why customer-facing invite emails wouldn't
# arrive (and never show up in the Resend dashboard) even though other
# Resend sends work fine. Set this once the domain is verified — invite
# emails start working immediately, no code change needed.
MAIL_FROM_ADDRESS="notifications@hetkin.app"
MAIL_FROM_NAME="Hetkin"

# App\Domain\...\Actions\{ResendInvitationAction,CreateAdminUserAction}
# (via App\Notifications\{InvitationResent,PilotApplicationApproved,
# AdminAccountCreated}) — the API key the `resend` mailer above needs.
RESEND_API_KEY=

# Where App\Notifications\PilotApplicationSubmitted (internal "new pilot
# application" alert) is sent — config/mail.php's `pilot_notification_
# address`, defaulting to hello@hetkin.app if unset. Mirrors v2's
# CONTACT_EMAIL exactly.
CONTACT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ENTSO-E Transparency Platform API token — required for
# App\Domain\Pricing\Services\EntsoeClient (Stage 10's price-ingestion
# job) to fetch real day-ahead prices. Missing/empty fails closed with a
# non-retryable EntsoeFetchException, matching v2's own
# `if (!token) throw new EntsoeFetchError("ENTSO_E_TOKEN not configured")`.
ENTSO_E_TOKEN=

# ── Analytics (PostHog) — Stage 11 ──────────────────────────────────────
# Same real PostHog project key/host in both pairs below — split into a
# server pair (read directly by PHP, App\Domain\Analytics\Services\
# PostHogService) and a VITE_-prefixed client pair (bundled into the
# browser build, resources/js/app.tsx) because Vite only exposes
# VITE_-prefixed vars to client code, unlike v2's single NEXT_PUBLIC_
# pair which served both. Missing/empty makes both sides a silent no-op —
# same "log instead of crash" posture as every other optional integration
# here (Resend, Sentry).
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Error tracking (Sentry) — Stage 11 ───────────────────────────────────
# Server-side (sentry/sentry-laravel, config/sentry.php) and client-side
# (resources/js/app.tsx) both read a DSN — normally the exact same Sentry
# project DSN for both, split the same VITE_-prefix way as PostHog above.
# Missing/empty makes the SDK no-op rather than throwing or sending
# anything, matching v2's own `dsn: process.env.NEXT_PUBLIC_SENTRY_DSN`
# with no fallback string.
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN=
